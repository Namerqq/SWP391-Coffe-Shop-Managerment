# Cổng server sẽ chạy
PORT=8080

# Chuỗi kết nối Database (MongoDB ví dụ)
DB_URI=mongodb://localhost:27017/my_database

# Các biến bí mật khác
JWT_SECRET=your_jwt_secret_key

# Domain thật của frontend khi deploy (dùng cho CORS + Socket.IO)
# Khi chạy local để trống hoặc để "*"
CLIENT_URL=https://your-frontend-domain.com
