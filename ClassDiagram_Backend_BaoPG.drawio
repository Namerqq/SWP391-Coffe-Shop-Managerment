        <mxCell id="ent_receipt" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;entity&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;StockReceipt&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #666; margin: 4px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35;&quot;&gt;- id : Long&lt;br&gt;- receiptCode : String (PN/YC-...)&lt;br&gt;- receiptType : String&lt;br&gt;- status : Status (DRAFT/RECEIVED/CANCELLED)&lt;br&gt;- supplierName : String&lt;br&gt;- totalAmount : BigDecimal&lt;br&gt;- receiptDate : LocalDate&lt;br&gt;- items : List&amp;lt;StockReceiptItem&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #666; margin: 4px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35;&quot;&gt;+ calculateTotal() : BigDecimal&lt;br&gt;+ confirm() : void&lt;br&gt;+ cancel() : void&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=0;" vertex="1" parent="1">
