        <mxCell id="banner" value="ĐỒ ÁN SWP391 - COFFEE SHOP MANAGEMENT SYSTEM&#xa;BACKEND DESIGN CLASS DIAGRAM (SPRING BOOT 3) - PHÂN HỆ QUẢN LÝ KHO &amp; BARISTA (BaoPG)&#xa;Cấu trúc phân tầng: Controller -&gt; DTO -&gt; Service -&gt; Repository -&gt; Entity" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontFamily=Helvetica;fontSize=11;size=14;align=left;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
