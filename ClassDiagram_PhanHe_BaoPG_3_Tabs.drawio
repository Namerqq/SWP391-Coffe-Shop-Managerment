        <mxCell id="e3_c_dto2" value="returns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endSize=8;strokeColor=#4d4d4d;strokeWidth=1.2;" edge="1" parent="1" source="c_barista" target="dto_order_view"><mxGeometry relative="1" as="geometry"/></mxCell>

