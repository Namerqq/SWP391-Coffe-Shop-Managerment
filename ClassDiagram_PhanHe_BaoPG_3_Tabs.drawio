        <mxCell id="e3_s_r1" value="injects" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=8;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="s_barista" target="r_order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3_s_r2" value="injects" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=8;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="s_inv_deduct" target="r_recipe"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e3_r_e1" value="manages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endSize=8;strokeColor=#4d4d4d;strokeWidth=1.2;" edge="1" parent="1" source="r_order" target="e_order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3_r_e2" value="manages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endSize=8;strokeColor=#4d4d4d;strokeWidth=1.2;" edge="1" parent="1" source="r_recipe" target="e_recipe"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Entity Relationships -->
        <!-- Order owns OrderItem (Composition, diamond at Order) -->
        <mxCell id="e3_comp1" value="1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamond;startFill=1;startSize=14;endArrow=none;strokeColor=#000000;strokeWidth=1.4;" edge="1" parent="1" source="e_order" target="e_order_item"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- OrderItem references MenuItem (Association) -->
        <mxCell id="e3_assoc1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="e_order_item" target="e_menu_item"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- MenuItem owns Recipe (Composition, diamond at MenuItem) -->
        <mxCell id="e3_comp2" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamond;startFill=1;startSize=14;endArrow=none;strokeColor=#000000;strokeWidth=1.4;" edge="1" parent="1" source="e_menu_item" target="e_recipe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Recipe owns RecipeIngredient (Composition, diamond at Recipe) -->
        <mxCell id="e3_comp3" value="1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamond;startFill=1;startSize=14;endArrow=none;strokeColor=#000000;strokeWidth=1.4;" edge="1" parent="1" source="e_recipe" target="e_recipe_ing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- RecipeIngredient consumes InventoryItem (Aggregation, diamond at RecipeIngredient) -->
        <mxCell id="e3_agg1" value="consumes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamond;startFill=0;startSize=14;endArrow=none;strokeColor=#000000;strokeWidth=1.4;" edge="1" parent="1" source="e_recipe_ing" target="e_inv_target"><mxGeometry relative="1" as="geometry"/></mxCell>

