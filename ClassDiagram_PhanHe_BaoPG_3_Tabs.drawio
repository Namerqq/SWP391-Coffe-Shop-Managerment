  <diagram id="diag_stock_receipt" name="1. Nhập Kho (Stock Receipt)">
    
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="banner1" value="PHÂN HỆ QUẢN LÝ KHO (BaoPG) - TÍNH NĂNG 1: QUẢN LÝ PHIẾU NHẬP KHO (STOCK RECEIPT)&#xa;Luồng: Tạo phiếu nháp -&gt; Cập nhật -&gt; Xác nhận nhập kho (cộng tồn kho &amp; ghi thẻ kho) -&gt; Hủy phiếu" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontFamily=Helvetica;fontSize=11;size=14;align=left;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="55" as="geometry" />
        </mxCell>

        <!-- CONTROLLER -->
        
    <mxCell id="c_receipt" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;controller&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;ManagerStockReceiptController&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;- service : StockReceiptService&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ createDraft(req : StockReceiptRequest) : StockReceiptView&lt;br&gt;+ updateDraft(id : Long, req) : StockReceiptView&lt;br&gt;+ confirmReceipt(id : Long) : StockReceiptView&lt;br&gt;+ cancelReceipt(id : Long) : StockReceiptView&lt;br&gt;+ list(status, kw, pageable) : Page&amp;lt;StockReceiptView&amp;gt;&lt;br&gt;+ getById(id : Long) : StockReceiptView&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="110" width="340" height="175" as="geometry" />
    </mxCell>
  

        <!-- DTOs -->
        
    <mxCell id="dto_receipt_req" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;dto&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;StockReceiptRequest&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ receiptType : String&lt;br&gt;+ supplierName : String&lt;br&gt;+ note : String&lt;br&gt;+ items : List&amp;lt;StockReceiptItemRequest&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ getItems() : List&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="330" width="260" height="115" as="geometry" />
    </mxCell>
  

        
    <mxCell id="dto_receipt_view" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;dto&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;StockReceiptView&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ id : Long&lt;br&gt;+ receiptCode : String&lt;br&gt;+ status : String&lt;br&gt;+ totalAmount : BigDecimal&lt;br&gt;+ items : List&amp;lt;StockReceiptItemView&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ totalAmount() : BigDecimal&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="480" width="260" height="125" as="geometry" />
    </mxCell>
  

        <!-- SERVICE -->
        
    <mxCell id="s_receipt" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;service&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;StockReceiptService&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;- receiptRepo : StockReceiptRepository&lt;br&gt;- itemRepo : StockReceiptItemRepository&lt;br&gt;- invRepo : InventoryItemRepository&lt;br&gt;- txRepo : StockTransactionRepository&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ createDraft(req, user) : StockReceiptView&lt;br&gt;+ updateDraft(id, req, user) : StockReceiptView&lt;br&gt;+ confirmReceipt(id, user) : StockReceiptView&lt;br&gt;+ cancelReceipt(id, user) : StockReceiptView&lt;br&gt;+ list(status, kw, pageable) : Page&lt;br&gt;+ getById(id : Long) : StockReceiptView&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="440" y="110" width="320" height="210" as="geometry" />
    </mxCell>
  

        <!-- REPOSITORIES -->
        
    <mxCell id="r_receipt" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;repository&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;StockReceiptRepository&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ findWithDetailsById(id : Long) : Optional&amp;lt;StockReceipt&amp;gt;&lt;br&gt;+ findByStatus(status, pageable) : Page&amp;lt;StockReceipt&amp;gt;&lt;br&gt;+ searchReceipts(kw, pageable) : Page&amp;lt;StockReceipt&amp;gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="440" y="370" width="320" height="95" as="geometry" />
    </mxCell>
  

        
    <mxCell id="r_receipt_item" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;repository&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;StockReceiptItemRepository&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ findByReceiptId(id : Long) : List&amp;lt;StockReceiptItem&amp;gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="440" y="495" width="320" height="75" as="geometry" />
    </mxCell>
  

        
    <mxCell id="r_inv" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;repository&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;InventoryItemRepository&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ findById(id : Long) : Optional&amp;lt;InventoryItem&amp;gt;&lt;br&gt;+ save(item : InventoryItem) : InventoryItem&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="440" y="600" width="320" height="75" as="geometry" />
    </mxCell>
  

        <!-- ENTITIES -->
        
    <mxCell id="e_receipt" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;entity&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;StockReceipt&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;- id : Long&lt;br&gt;- receiptCode : String (PN-...)&lt;br&gt;- receiptType : String&lt;br&gt;- status : Status (DRAFT/RECEIVED/CANCELLED)&lt;br&gt;- supplierName : String&lt;br&gt;- totalAmount : BigDecimal&lt;br&gt;- items : List&amp;lt;StockReceiptItem&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ calculateTotal() : BigDecimal&lt;br&gt;+ confirm() : void&lt;br&gt;+ cancel() : void&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="840" y="110" width="270" height="210" as="geometry" />
    </mxCell>
  

        
    <mxCell id="e_receipt_item" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;entity&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;StockReceiptItem&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;- id : Long&lt;br&gt;- receipt : StockReceipt&lt;br&gt;- inventoryItem : InventoryItem&lt;br&gt;- quantity : BigDecimal&lt;br&gt;- unitPrice : BigDecimal&lt;br&gt;- lineTotal : BigDecimal&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ calculateLineTotal() : BigDecimal&lt;br&gt;+ getInventoryItem() : InventoryItem&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#b1ddf0;strokeColor=#10739e;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="840" y="370" width="270" height="160" as="geometry" />
    </mxCell>
  

        
