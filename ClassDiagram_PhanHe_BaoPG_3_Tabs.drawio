        <mxCell id="banner2" value="PHÂN HỆ QUẢN LÝ KHO (BaoPG) - TÍNH NĂNG 2: TỒN KHO &amp; LỊCH SỬ BIẾN ĐỘNG (THẺ KHO)&#xa;Luồng: Xem danh sách tồn kho -&gt; Cảnh báo sắp hết (low-stock) -&gt; Nhập kho nhanh -&gt; Tra cứu lịch sử thẻ kho" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontFamily=Helvetica;fontSize=11;size=14;align=left;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="55" as="geometry" />
        </mxCell>

        <!-- CONTROLLER -->
        
    <mxCell id="c_inv" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;controller&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;ManagerInventoryController&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;- service : InventoryService&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ list() : List&amp;lt;InventoryItemView&amp;gt;&lt;br&gt;+ lowStock() : List&amp;lt;InventoryItemView&amp;gt;&lt;br&gt;+ stats() : Map&amp;lt;String, Object&amp;gt;&lt;br&gt;+ stockIn(id : Long, req : StockInRequest) : InventoryItemView&lt;br&gt;+ history(id : Long) : List&amp;lt;StockTransactionView&amp;gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="110" width="340" height="160" as="geometry" />
    </mxCell>
  

        <!-- DTOs -->
        
    <mxCell id="dto_inv_view" value="&lt;p style=&quot;text-align: center; margin: 0; padding: 2px 0;&quot;&gt;&lt;b&gt;&amp;laquo;dto&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b&gt;InventoryItemView&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border: none; border-top: 1px solid #777; margin: 3px 0;&quot;/&gt;&lt;p style=&quot;margin: 0; padding-left: 2px; line-height: 1.35; font-size: 10px;&quot;&gt;+ id : Long&lt;br&gt;+ itemName : String&lt;br&gt;+ currentQuantity : BigDecimal&lt;br&gt;+ minQuantity : BigDecimal&lt;br&gt;+ costPerUnit : BigDecimal&lt;br&gt;+ status : String&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontFamily=Helvetica;fontSize=10.5;spacingLeft=6;spacingRight=6;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="310" width="260" height="120" as="geometry" />
