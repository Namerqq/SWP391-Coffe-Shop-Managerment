        <!-- CONNECTIONS -->
        <mxCell id="e3_c_s1" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=8;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="c_barista" target="s_barista"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3_c_s2" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=8;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="c_barista" target="s_inv_deduct"><mxGeometry relative="1" as="geometry"/></mxCell>
