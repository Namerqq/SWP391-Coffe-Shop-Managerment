      <mxGeometry x="840" y="580" width="270" height="140" as="geometry" />
    </mxCell>
  

        <!-- CONNECTIONS -->
        <mxCell id="e1_c_s" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=8;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="c_receipt" target="s_receipt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_c_dto1" value="consumes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endSize=8;strokeColor=#4d4d4d;strokeWidth=1.2;" edge="1" parent="1" source="c_receipt" target="dto_receipt_req"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_c_dto2" value="returns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endSize=8;strokeColor=#4d4d4d;strokeWidth=1.2;" edge="1" parent="1" source="c_receipt" target="dto_receipt_view"><mxGeometry relative="1" as="geometry"/></mxCell>
        
        <mxCell id="e1_s_r1" value="injects" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=8;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="s_receipt" target="r_receipt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_s_r2" value="injects" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=8;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="s_receipt" target="r_receipt_item"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_s_r3" value="injects" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=8;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="s_receipt" target="r_inv"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e1_r_e1" value="manages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endSize=8;strokeColor=#4d4d4d;strokeWidth=1.2;" edge="1" parent="1" source="r_receipt" target="e_receipt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_r_e2" value="manages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endSize=8;strokeColor=#4d4d4d;strokeWidth=1.2;" edge="1" parent="1" source="r_receipt_item" target="e_receipt_item"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_r_e3" value="manages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endSize=8;strokeColor=#4d4d4d;strokeWidth=1.2;" edge="1" parent="1" source="r_inv" target="e_inv_item"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Composition: StockReceipt owns StockReceiptItem (Diamond at StockReceipt) -->
        <mxCell id="e1_comp" value="1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamond;startFill=1;startSize=14;endArrow=none;strokeColor=#000000;strokeWidth=1.4;" edge="1" parent="1" source="e_receipt" target="e_receipt_item"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Aggregation: StockReceiptItem references InventoryItem (Diamond at StockReceiptItem) -->
        <mxCell id="e1_agg" value="references" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=diamond;startFill=0;startSize=14;endArrow=none;strokeColor=#000000;strokeWidth=1.4;" edge="1" parent="1" source="e_receipt_item" target="e_inv_item"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
